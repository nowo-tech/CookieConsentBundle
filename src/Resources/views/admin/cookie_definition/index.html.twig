{# Cookie inventory list. Chrome hooks (1.13+): web_ui.chrome classes / attributes / templates and the
   nowo_cookie_consent_admin_* blocks below (override from a page fork extending '@!NowoCookieConsentBundle/…'). #}
{% extends '@NowoCookieConsentBundle/admin/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% import '@NowoCookieConsentBundle/admin/_chrome.html.twig' as chrome %}
{% set _css_fw = nowo_cookie_consent_css_framework|default('bootstrap5') %}
{% set _chrome = nowo_cookie_consent_admin_chrome %}
{% set _cls = _chrome.classes %}
{% set _attrs = _chrome.attributes %}

{% block title %}{{ 'nowo_cookie_consent.admin.cookie_definition.title'|trans({'%profile%': config.displayName}, 'NowoCookieConsentBundle') }}{% endblock %}

{% block body %}
    {% block nowo_cookie_consent_admin_area_nav %}
        {{ include('@NowoCookieConsentBundle/admin/_admin_area_nav.html.twig', {config: config}, false) }}
    {% endblock %}

    {% block nowo_cookie_consent_admin_page_header %}
        <div class="{{ _cls.page_header }}"{{ chrome.attrs(_attrs.page_header ?? {}) }}>
            <div>
                {% block nowo_cookie_consent_admin_page_title %}
                    {% if _chrome.page_title_tag != 'none' %}
                        <{{ _chrome.page_title_tag }} class="{{ _cls.page_title }}"{{ chrome.attrs(_attrs.page_title ?? {}) }}>{{ 'nowo_cookie_consent.admin.cookie_definition.title'|trans({'%profile%': config.displayName}, 'NowoCookieConsentBundle') }}</{{ _chrome.page_title_tag }}>
                    {% endif %}
                {% endblock %}
                {% block nowo_cookie_consent_admin_page_intro %}
                    <p class="{{ _cls.page_intro }}"{{ chrome.attrs(_attrs.page_intro ?? {}) }}>{{ 'nowo_cookie_consent.admin.cookie_definition.lead'|trans({}, 'NowoCookieConsentBundle') }}</p>
                {% endblock %}
            </div>
            {% block nowo_cookie_consent_admin_page_actions %}
                <a class="{{ _cls.button_primary ?? ui.btn('primary', null, _css_fw) }} nowo-ui-action-create" href="{{ path('nowo_cookie_consent_cookie_definitions_new', {configId: config.id}) }}"{{ chrome.attrs(_attrs.button_primary ?? {}) }}>{{ 'nowo_cookie_consent.admin.cookie_definition.new'|trans({}, 'NowoCookieConsentBundle') }}</a>
            {% endblock %}
        </div>
    {% endblock %}

    {% block nowo_cookie_consent_admin_table_wrapper %}
        <div class="{{ _cls.table_panel }}"{{ chrome.attrs(_attrs.table_panel ?? {}) }}>
            {{ include('@NowoCookieConsentBundle/admin/cookie_definition/_table.html.twig') }}
        </div>
    {% endblock %}

    {% block nowo_cookie_consent_admin_pagination %}
        {{ include(_chrome.templates.pagination, {
            page: page,
            pages: pages,
            total: total,
            page_size: pageSize|default(null),
            item_count: definitions|length,
            framework: _css_fw,
        }) }}
    {% endblock %}
{% endblock %}
