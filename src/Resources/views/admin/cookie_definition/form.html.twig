{% extends '@NowoCookieConsentBundle/admin/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_cookie_consent_css_framework|default('bootstrap5') %}
{% form_theme form with ['bootstrap_5_layout.html.twig'] %}

{% block title %}{{ isNew ? 'nowo_cookie_consent.admin.cookie_definition.new_title'|trans({}, 'NowoCookieConsentBundle') : 'nowo_cookie_consent.admin.cookie_definition.edit_title'|trans({'%name%': definition.name}, 'NowoCookieConsentBundle') }}{% endblock %}

{% block body %}
    {% include '@NowoCookieConsentBundle/admin/_admin_area_nav.html.twig' with {config: config} only %}

    <div class="nowo-ui-page-header mb-4">
        <h1 class="h3 mb-1">{{ isNew ? 'nowo_cookie_consent.admin.cookie_definition.new_title'|trans({}, 'NowoCookieConsentBundle') : 'nowo_cookie_consent.admin.cookie_definition.edit_title'|trans({'%name%': definition.name}, 'NowoCookieConsentBundle') }}</h1>
        <p class="text-muted mb-0">{{ 'nowo_cookie_consent.admin.cookie_definition.form_lead'|trans({'%profile%': config.displayName}, 'NowoCookieConsentBundle') }}</p>
    </div>

    <div class="card shadow-sm nowo-ui-form-wrap">
        <div class="card-body">
            {{ form_start(form) }}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="{{ ui.btn('primary', null, _css_fw) }} nowo-ui-action-save">{{ 'nowo_cookie_consent.admin.cookie_definition.save'|trans({}, 'NowoCookieConsentBundle') }}</button>
                    <a class="{{ ui.btn('secondary', null, _css_fw) }} nowo-ui-action-cancel" href="{{ path('nowo_cookie_consent_cookie_definitions_index', { configId: config.id }) }}">{{ 'nowo_cookie_consent.admin.cookie_definition.cancel'|trans({}, 'NowoCookieConsentBundle') }}</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
