{# Cookie definition create/edit. Chrome hooks (1.13+): web_ui.chrome classes / attributes, templates.form_theme
   (~ = no theme), templates.form_fields (host partial receiving {form}) and the nowo_cookie_consent_admin_* blocks. #}
{% extends '@NowoCookieConsentBundle/admin/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% import '@NowoCookieConsentBundle/admin/_chrome.html.twig' as chrome %}
{% set _css_fw = nowo_cookie_consent_css_framework|default('bootstrap5') %}
{% set _chrome = nowo_cookie_consent_admin_chrome %}
{% set _cls = _chrome.classes %}
{% set _attrs = _chrome.attributes %}
{% set _page_title = isNew ? 'nowo_cookie_consent.admin.cookie_definition.new_title'|trans({}, 'NowoCookieConsentBundle') : 'nowo_cookie_consent.admin.cookie_definition.edit_title'|trans({'%name%': definition.name}, 'NowoCookieConsentBundle') %}

{% block title %}{{ _page_title }}{% endblock %}

{% block body %}
    {% if _chrome.templates.form_theme %}
        {% form_theme form with [_chrome.templates.form_theme] %}
    {% endif %}

    {% block nowo_cookie_consent_admin_area_nav %}
        {{ include('@NowoCookieConsentBundle/admin/_admin_area_nav.html.twig', {config: config}, false) }}
    {% endblock %}

    {% block nowo_cookie_consent_admin_page_header %}
        <div class="{{ _cls.page_header_form }}"{{ chrome.attrs(_attrs.page_header_form ?? {}) }}>
            {% block nowo_cookie_consent_admin_page_title %}
                {% if _chrome.page_title_tag != 'none' %}
                    <{{ _chrome.page_title_tag }} class="{{ _cls.page_title }}"{{ chrome.attrs(_attrs.page_title ?? {}) }}>{{ _page_title }}</{{ _chrome.page_title_tag }}>
                {% endif %}
            {% endblock %}
            {% block nowo_cookie_consent_admin_page_intro %}
                <p class="{{ _cls.page_intro }}"{{ chrome.attrs(_attrs.page_intro ?? {}) }}>{{ 'nowo_cookie_consent.admin.cookie_definition.form_lead'|trans({'%profile%': config.displayName}, 'NowoCookieConsentBundle') }}</p>
            {% endblock %}
        </div>
    {% endblock %}

    {% block nowo_cookie_consent_admin_form_wrapper %}
        <div class="{{ _cls.form_panel }}"{{ chrome.attrs(_attrs.form_panel ?? {}) }}>
            {% if _cls.form_panel_body %}<div class="{{ _cls.form_panel_body }}">{% endif %}
                {{ form_start(form, _cls.form ? {attr: {class: _cls.form}} : {}) }}
                    {% block nowo_cookie_consent_admin_form_body %}
                        {% if _chrome.templates.form_fields %}
                            {{ include(_chrome.templates.form_fields, {form: form}, false) }}
                        {% else %}
                            {% for child in form %}
                                {% if not child.rendered %}
                                    {{ form_row(child) }}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% endblock %}

                    {% block nowo_cookie_consent_admin_form_actions %}
                        <div class="{{ _cls.form_actions }}"{{ chrome.attrs(_attrs.form_actions ?? {}) }}>
                            <button type="submit" class="{{ _cls.button_primary ?? ui.btn('primary', null, _css_fw) }} nowo-ui-action-save">{{ 'nowo_cookie_consent.admin.cookie_definition.save'|trans({}, 'NowoCookieConsentBundle') }}</button>
                            <a class="{{ _cls.button_secondary ?? ui.btn('secondary', null, _css_fw) }} nowo-ui-action-cancel" href="{{ path('nowo_cookie_consent_cookie_definitions_index', {configId: config.id}) }}">{{ 'nowo_cookie_consent.admin.cookie_definition.cancel'|trans({}, 'NowoCookieConsentBundle') }}</a>
                        </div>
                    {% endblock %}
                {{ form_end(form) }}
            {% if _cls.form_panel_body %}</div>{% endif %}
        </div>
    {% endblock %}
{% endblock %}
