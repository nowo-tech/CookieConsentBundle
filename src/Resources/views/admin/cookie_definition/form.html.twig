{#
  Cookie definition create / edit (REQ-UI-003): UiKit form scaffold.
  View model: page (View\FormPage, AdminPageFactory::definitionForm()). Extra context: area_nav.
  Data blocks: nowo_ui_form_body (REQ-TWIG-003 child loop; the deprecated web_ui.chrome.templates.form_fields partial
  renders first when configured). Bundle block: nowo_cookie_consent_admin_area_nav (above the page header).
  The form theme comes from the host (twig.form_themes); the deprecated web_ui.chrome.templates.form_theme still
  applies when configured.
#}
{% extends '@NowoUiKit/page/form.html.twig' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {%- if nowo_cookie_consent_admin_chrome.templates.styles_after|default(null) %}{{ include(nowo_cookie_consent_admin_chrome.templates.styles_after) }}{% endif -%}
{% endblock %}

{% block nowo_ui_page_header %}
    {% block nowo_cookie_consent_admin_area_nav %}
        {{ include('@NowoCookieConsentBundle/admin/_admin_area_nav.html.twig', {area_nav: area_nav|default([]), bundle: page.bundle}, false) }}
    {% endblock %}
    {{ parent() }}
{% endblock %}

{% block nowo_ui_content %}
    {%- if nowo_cookie_consent_admin_chrome.templates.form_theme|default(null) %}
        {% form_theme page.form with [nowo_cookie_consent_admin_chrome.templates.form_theme] %}
    {% endif -%}
    {{ parent() }}
{% endblock %}

{% block nowo_ui_form_body %}
    {%- if nowo_cookie_consent_admin_chrome.templates.form_fields|default(null) %}
        {{ include(nowo_cookie_consent_admin_chrome.templates.form_fields, {form: form}, false) }}
    {% endif -%}
    {{ parent() }}
{% endblock %}
