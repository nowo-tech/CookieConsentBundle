{#
  Translations of a cookie definition as a table: one row per locale (locale code as the row header cell, provider,
  purpose). Every widget keeps its form name / id / constraints; errors render under the widget they belong to.
  Variables: translations (FormView of the CollectionType), bundle (UiKit bundle key for nowo_ui_class()).
#}
{% set _domain = 'NowoCookieConsentBundle' %}
{% set _prefix = 'nowo_cookie_consent.admin.cookie_definition.fields.' %}
{% set _cell = nowo_ui_class('table_cell', bundle) %}
{% set _head = nowo_ui_class('table_head_cell', bundle) %}
{% set _locale_label = (_prefix ~ 'locale')|trans({}, _domain) %}
{% set _provider_label = (_prefix ~ 'provider')|trans({}, _domain) %}
{% set _purpose_label = (_prefix ~ 'purpose')|trans({}, _domain) %}
<fieldset class="nowo-cc-admin-translations" id="{{ translations.vars.id }}" data-nowo-cc-region="translations">
    <legend class="nowo-cc-admin-translations__legend">{{ (_prefix ~ 'translations')|trans({}, _domain) }}</legend>
    <p class="{{ nowo_ui_class('muted', bundle) }} nowo-cc-admin-translations__help">{{ (_prefix ~ 'locale_help')|trans({}, _domain) }}</p>
    {{ form_errors(translations) }}
    <div class="{{ nowo_ui_class('table_wrap', bundle) }}"{{ nowo_ui_attrs('table_wrap', bundle) }}>
        <table class="{{ nowo_ui_class('table', bundle) }} nowo-cc-admin-translations__table"{{ nowo_ui_attrs('table', bundle) }}>
            <thead class="{{ nowo_ui_class('table_head', bundle) }}">
                <tr class="{{ nowo_ui_class('table_head_row', bundle) }}">
                    <th scope="col" class="{{ _head }} nowo-cc-admin-translations__locale">{{ _locale_label }}</th>
                    <th scope="col" class="{{ _head }} nowo-cc-admin-translations__provider">{{ _provider_label }}</th>
                    <th scope="col" class="{{ _head }}">{{ _purpose_label }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in translations %}
                    {% set _locale = entry.locale is defined ? entry.locale.vars.value : '' %}
                    {% set _suffix = _locale is not empty ? ' (' ~ _locale ~ ')' : '' %}
                    <tr class="{{ nowo_ui_class('table_row', bundle) }}" data-nowo-cc-translation="{{ _locale }}">
                        {% if entry.locale is defined %}
                            <th scope="row" class="{{ _cell }} nowo-cc-admin-translations__locale" data-label="{{ _locale_label }}">
                                {{ form_widget(entry.locale, {attr: entry.locale.vars.attr|merge({'aria-label': _locale_label ~ _suffix})}) }}
                                {{ form_errors(entry.locale) }}
                            </th>
                        {% endif %}
                        {% if entry.provider is defined %}
                            <td class="{{ _cell }}" data-label="{{ _provider_label }}">
                                {{ form_widget(entry.provider, {attr: entry.provider.vars.attr|merge({'aria-label': _provider_label ~ _suffix})}) }}
                                {{ form_errors(entry.provider) }}
                            </td>
                        {% endif %}
                        {% if entry.purpose is defined %}
                            <td class="{{ _cell }}" data-label="{{ _purpose_label }}">
                                {{ form_widget(entry.purpose, {attr: entry.purpose.vars.attr|merge({'aria-label': _purpose_label ~ _suffix})}) }}
                                {{ form_errors(entry.purpose) }}
                                {{ form_errors(entry) }}
                                {# Extra children a host form extension adds to an entry stay in the form. #}
                                {% for child in entry %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</fieldset>
{% do translations.setRendered() %}
