{# Cookie inventory table. Chrome hooks (1.13+): chrome.classes table_wrap / table / *_cell / confirm_*,
   chrome.row_actions_display, and blocks nowo_cookie_consent_admin_table_head / _row_actions / _empty_state
   (override from a fork extending '@!NowoCookieConsentBundle/admin/cookie_definition/_table.html.twig'). #}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% import '@NowoCookieConsentBundle/admin/_chrome.html.twig' as chrome %}
{% set _css_fw = nowo_cookie_consent_css_framework|default('bootstrap5') %}
{% set _chrome = nowo_cookie_consent_admin_chrome %}
{% set _cls = _chrome.classes %}
{% set _attrs = _chrome.attributes %}
<div class="{{ _cls.table_wrap }}"{{ chrome.attrs(_attrs.table_wrap ?? {}) }}>
    <table class="{{ _cls.table }}"{{ chrome.attrs(_attrs.table ?? {}) }}>
        {% block nowo_cookie_consent_admin_table_head %}
        <thead>
            <tr>
                <th>{{ 'nowo_cookie_consent.admin.cookie_definition.table.name'|trans({}, 'NowoCookieConsentBundle') }}</th>
                <th>{{ 'nowo_cookie_consent.admin.cookie_definition.table.provider'|trans({}, 'NowoCookieConsentBundle') }}</th>
                <th>{{ 'nowo_cookie_consent.admin.cookie_definition.table.purpose'|trans({}, 'NowoCookieConsentBundle') }}</th>
                <th>{{ 'nowo_cookie_consent.admin.cookie_definition.table.category'|trans({}, 'NowoCookieConsentBundle') }}</th>
                <th>{{ 'nowo_cookie_consent.admin.cookie_definition.table.duration'|trans({}, 'NowoCookieConsentBundle') }}</th>
                <th>{{ 'nowo_cookie_consent.admin.cookie_definition.table.allowed_by_default'|trans({}, 'NowoCookieConsentBundle') }}</th>
                <th class="{{ _cls.table_actions_cell }}">{{ 'nowo_cookie_consent.admin.cookie_definition.table.actions'|trans({}, 'NowoCookieConsentBundle') }}</th>
            </tr>
        </thead>
        {% endblock %}
        <tbody>
            {% for definition in definitions %}
                {% set translation = definition.findTranslation(app.request.locale) ?? definition.findTranslation('en') %}
                {% set confirm_id = 'delete-cookie-definition-' ~ definition.id %}
                <tr>
                    <td><code>{{ definition.name }}</code></td>
                    <td>{{ translation ? translation.provider : '' }}</td>
                    <td class="{{ _cls.table_muted_cell }}">{{ translation ? translation.purpose : '' }}</td>
                    <td>{{ ('nowo_cookie_consent.admin.cookie_definition.category.' ~ definition.category)|trans({}, 'NowoCookieConsentBundle') }}</td>
                    <td>{{ definition.duration }}</td>
                    <td>{{ definition.allowedByDefault ? 'nowo_cookie_consent.admin.cookie_definition.yes'|trans({}, 'NowoCookieConsentBundle') : 'nowo_cookie_consent.admin.cookie_definition.no'|trans({}, 'NowoCookieConsentBundle') }}</td>
                    <td class="{{ _cls.table_actions_cell }}">
                        {% block nowo_cookie_consent_admin_row_actions %}
                        {% set _row_actions = {
                            framework: _css_fw,
                            actions: [
                                {
                                    kind: 'edit',
                                    href: path('nowo_cookie_consent_cookie_definitions_edit', {configId: config.id, id: definition.id}),
                                    label: 'nowo_cookie_consent.admin.cookie_definition.edit'|trans({'%name%': definition.name}, 'NowoCookieConsentBundle'),
                                },
                                {
                                    kind: 'delete',
                                    tag: 'button',
                                    confirm_id: confirm_id,
                                    label: 'nowo_cookie_consent.admin.cookie_definition.delete'|trans({}, 'NowoCookieConsentBundle'),
                                },
                            ],
                        } %}
                        {% if _chrome.row_actions_display is not null %}
                            {% set _row_actions = _row_actions|merge({display: _chrome.row_actions_display}) %}
                        {% endif %}
                        {{ include('@NowoUiKitBundle/partials/_row_actions.html.twig', _row_actions) }}
                        {% set delete_form = delete_forms[definition.id] ?? null %}
                        {% set confirm_footer %}
                            <button type="button" class="{{ _cls.confirm_cancel ?? ui.btn('secondary', 'sm', _css_fw) }}" {{ ui.confirm_dismiss_attrs() }}>
                                {{ 'nowo_cookie_consent.admin.cookie_definition.cancel'|trans({}, 'NowoCookieConsentBundle') }}
                            </button>
                            {% if delete_form %}
                                {{ form_start(delete_form) }}
                                    {{ form_widget(delete_form._token) }}
                                    <button type="submit" class="{{ _cls.confirm_delete ?? ui.btn('danger', 'sm', _css_fw) }}">
                                        {{ 'nowo_cookie_consent.admin.cookie_definition.delete'|trans({}, 'NowoCookieConsentBundle') }}
                                    </button>
                                {{ form_end(delete_form, {render_rest: false}) }}
                            {% endif %}
                        {% endset %}
                        {{ include('@NowoUiKitBundle/partials/_confirm.html.twig', {
                            id: confirm_id,
                            title: 'nowo_cookie_consent.admin.cookie_definition.delete'|trans({}, 'NowoCookieConsentBundle'),
                            body: '<p>' ~ 'nowo_cookie_consent.admin.cookie_definition.delete_confirm'|trans({'%name%': definition.name}, 'NowoCookieConsentBundle')|e ~ '</p>',
                            footer: confirm_footer,
                            framework: _css_fw,
                        }) }}
                        {% endblock %}
                    </td>
                </tr>
            {% else %}
                {% block nowo_cookie_consent_admin_empty_state %}
                <tr>
                    <td colspan="7" class="{{ _cls.empty_cell }}"{{ chrome.attrs(_attrs.empty_cell ?? {}) }}>
                        {{ 'nowo_cookie_consent.admin.cookie_definition.empty'|trans({}, 'NowoCookieConsentBundle') }}
                    </td>
                </tr>
                {% endblock %}
            {% endfor %}
        </tbody>
    </table>
</div>
