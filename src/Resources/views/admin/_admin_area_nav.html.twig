{#
  Area navigation of a consent profile (Settings | Cookie inventory), rendered above the page header of every admin
  page through the UiKit `tabs` partial (theme slots tabs / tab / tab_active; region `area-nav`).
  Context: area_nav (AdminPageFactory::areaNav(): list of {label: View\Label, href, current}), bundle.
#}
{% if area_nav|default([]) is not empty %}
    {{ include(nowo_ui_partial('tabs', bundle|default(null)), {
        items: area_nav,
        aria_label: 'nowo_cookie_consent.admin.area_nav.label'|trans({}, 'NowoCookieConsentBundle'),
        region: 'area-nav',
        bundle: bundle|default(null),
    }, false) }}
{% endif %}
