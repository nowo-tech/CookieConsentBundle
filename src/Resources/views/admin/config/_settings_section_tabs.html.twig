{# Settings section tabs — one route per section. Expects config, section, sections.
   Markup comes from web_ui.chrome.templates.tabs (default admin/_tabs.html.twig); classes from chrome.classes. #}
{% set _chrome = nowo_cookie_consent_admin_chrome %}
{% set active = section.value %}
{% set items = [] %}
{% for item in sections %}
    {% set items = items|merge([{
        label: ('nowo_cookie_consent.admin.config.settings.section.' ~ item.translationSuffix())|trans({}, 'NowoCookieConsentBundle'),
        href: path('nowo_cookie_consent_config_settings_section', {configId: config.id, section: item.value}),
        current: item.value == active,
    }]) %}
{% endfor %}
{{ include(_chrome.templates.tabs, {
    variant: 'sections',
    aria_label: 'nowo_cookie_consent.admin.config.settings.section_tabs_label'|trans({}, 'NowoCookieConsentBundle'),
    nav_class: _chrome.classes.section_tabs,
    list_class: _chrome.classes.tab_list,
    item_class: _chrome.classes.tab_item,
    active_class: _chrome.classes.tab_item_active,
    attr: {'data-turbo': 'false'}|merge(_chrome.attributes.section_tabs ?? {}),
    framework: nowo_cookie_consent_css_framework|default('bootstrap5'),
    items: items,
}, false) }}
