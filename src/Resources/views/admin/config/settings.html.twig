{% extends '@NowoCookieConsentBundle/admin/base.html.twig' %}

{% set section_suffix = section.translationSuffix() %}

{% block title %}{{ 'nowo_cookie_consent.admin.config.settings.title'|trans({}, 'NowoCookieConsentBundle') }} — {{ config.displayName }}{% endblock %}

{% block body %}
    {% include '@NowoCookieConsentBundle/admin/_admin_area_nav.html.twig' with {config: config} only %}
    {% include '@NowoCookieConsentBundle/admin/config/_settings_section_tabs.html.twig' with {
        config: config,
        section: section,
        sections: sections,
    } only %}

    <div class="card shadow-sm nowo-ui-form-wrap">
        <div class="card-body p-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'success' ? 'success' : label }} mb-3 nowo-ui-flash" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <h2 class="h6 text-uppercase text-muted fw-semibold mb-1">
                {{ ('nowo_cookie_consent.admin.config.settings.section.' ~ section_suffix)|trans({}, 'NowoCookieConsentBundle') }}
            </h2>
            <p class="small text-muted mb-3">
                {{ ('nowo_cookie_consent.admin.config.settings.section.' ~ section_suffix ~ '_lead')|trans({}, 'NowoCookieConsentBundle') }}
            </p>

            {% form_theme form 'bootstrap_5_layout.html.twig' %}
            {{ form_start(form) }}
                {% for child in form %}
                    {% if child.vars.name != '_token' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}

                <div class="nowo-ui-form-actions mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary nowo-ui-action-save">
                        {{ 'nowo_cookie_consent.admin.config.settings.save'|trans({}, 'NowoCookieConsentBundle') }}
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
