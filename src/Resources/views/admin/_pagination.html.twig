{% if pages is defined and pages > 1 %}
    <nav class="nowo-ui-pagination d-flex justify-content-between align-items-center mt-3" aria-label="Pagination">
        <div class="text-muted small">
            {{ 'nowo_cookie_consent.admin.pagination.summary'|trans({
                '%page%': page,
                '%pages%': pages,
                '%total%': total
            }, 'NowoCookieConsentBundle') }}
        </div>
        <div class="btn-group btn-group-sm" role="group">
            {% if page > 1 %}
                <a class="btn btn-outline-secondary nowo-ui-action-prev" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({ page: page - 1 })) }}">
                    {{ 'nowo_cookie_consent.admin.pagination.prev'|trans({}, 'NowoCookieConsentBundle') }}
                </a>
            {% endif %}
            {% if page < pages %}
                <a class="btn btn-outline-secondary nowo-ui-action-next" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({ page: page + 1 })) }}">
                    {{ 'nowo_cookie_consent.admin.pagination.next'|trans({}, 'NowoCookieConsentBundle') }}
                </a>
            {% endif %}
        </div>
    </nav>
{% endif %}
