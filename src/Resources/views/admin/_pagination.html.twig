{# Default pagination partial (web_ui.chrome.templates.pagination). Receives page, pages, total, page_size,
   item_count, framework (plus the page context). Classes from chrome.classes.pagination*. #}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% import '@NowoCookieConsentBundle/admin/_chrome.html.twig' as chrome %}
{% set _css_fw = nowo_cookie_consent_css_framework|default('bootstrap5') %}
{% set _chrome = nowo_cookie_consent_admin_chrome %}
{% set _cls = _chrome.classes %}
{% set _btn = _cls.pagination_button ?? ui.btn('secondary', 'sm', _css_fw) %}
{% if pages is defined and pages > 1 %}
    <nav class="{{ _cls.pagination ?? (ui.pagination_wrap(_css_fw) ~ ' mt-3') }}" aria-label="{{ 'nowo_cookie_consent.admin.pagination.label'|trans({}, 'NowoCookieConsentBundle') }}"{{ chrome.attrs(_chrome.attributes.pagination ?? {}) }}>
        <div class="{{ _cls.pagination_summary }}">
            {{ 'nowo_cookie_consent.admin.pagination.summary'|trans({
                '%page%': page,
                '%pages%': pages,
                '%total%': total,
            }, 'NowoCookieConsentBundle') }}
        </div>
        <div class="{{ _cls.pagination_actions ?? ui.row_actions(_css_fw) }}" role="group">
            {% if page > 1 %}
                <a class="{{ _btn }} nowo-ui-action-prev" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({page: page - 1})) }}">
                    {{ 'nowo_cookie_consent.admin.pagination.prev'|trans({}, 'NowoCookieConsentBundle') }}
                </a>
            {% endif %}
            {% if page < pages %}
                <a class="{{ _btn }} nowo-ui-action-next" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all)|merge({page: page + 1})) }}">
                    {{ 'nowo_cookie_consent.admin.pagination.next'|trans({}, 'NowoCookieConsentBundle') }}
                </a>
            {% endif %}
        </div>
    </nav>
{% endif %}
