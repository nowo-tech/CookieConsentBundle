{# Default route-based tab strip (web_ui.chrome.templates.tabs). Host partials receive the same contract:
     aria_label (translated), items [{label, href, current}], nav_class, attr (hash), framework,
     list_class, item_class, active_class, variant (area|sections). #}
{% set attr = attr|default({}) %}
<nav class="{{ nav_class }}" aria-label="{{ aria_label }}"{% for name, value in attr %} {{ name|e('html_attr') }}="{{ value }}"{% endfor %}>
    <div class="{{ list_class }}">
        {% for item in items %}
            <a
                class="{{ item_class }}{{ item.current ? ' ' ~ active_class : '' }}"
                href="{{ item.href }}"
                {% if item.current %}aria-current="page"{% endif %}
            >{{ item.label }}</a>
        {% endfor %}
    </div>
</nav>
