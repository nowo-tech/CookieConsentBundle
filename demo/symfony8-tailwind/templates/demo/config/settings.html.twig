{% extends 'base.html.twig' %}
{% import 'demo/_routes.html.twig' as demo_route %}

{% block title %}{{ 'demo.config.settings.title'|trans }}{% endblock %}

{% block body %}
    {% include 'demo/_nav.html.twig' %}

    <main class="mx-auto max-w-3xl px-4 pb-10">
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h1 class="text-xl font-semibold text-slate-900">
                {% if is_new_profile|default(false) %}
                    {{ 'demo.config.new_profile'|trans }}
                {% else %}
                    {{ 'demo.config.settings.title'|trans }} — {{ config.displayName }}
                {% endif %}
            </h1>
            <p class="mt-2 text-sm text-slate-600">{{ 'demo.config.settings.lead_profiles'|trans }}</p>

            {{ form_start(form, {attr: {class: 'mt-6 space-y-6'}}) }}
                {# Sections open at the first field of each settings section (CookieConsentConfigFullSettingsType order); the child loop renders every field. #}
                {% set _sections = {
                    'enabled': ['demo.config.settings.section.profile'|trans, 'demo.config.settings.section.profile_lead'|trans],
                    'autoShow': ['demo.config.settings.section.behavior'|trans, 'demo.config.settings.section.behavior_lead'|trans],
                    'colorTheme': ['demo.config.settings.section.appearance'|trans, 'demo.config.settings.section.appearance_lead'|trans],
                    'consentModalLayout': ['demo.config.settings.section.consent_modal'|trans, 'demo.config.settings.section.consent_modal_lead'|trans],
                    'preferencesModalLayout': ['demo.config.settings.section.preferences_modal'|trans, 'demo.config.settings.section.preferences_modal_lead'|trans],
                    'autoShowRouteMode': ['demo.config.settings.section.route_targeting'|trans, 'demo.config.settings.section.route_targeting_lead'|trans],
                } %}
                {% set _section_open = false %}
                {% for child in form %}
                    {% if not child.rendered %}
                        {% if _sections[child.vars.name] is defined %}
                            {% set _section = _sections[child.vars.name] %}
                            {% if _section_open %}</section>{% endif %}
                            <section class="rounded-lg border border-slate-200 bg-slate-50/60 p-4 space-y-4">
                                <div>
                                    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-700">{{ _section[0] }}</h2>
                                    <p class="mt-1 text-sm text-slate-500">{{ _section[1] }}</p>
                                </div>
                            {% set _section_open = true %}
                        {% endif %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                {% if _section_open %}</section>{% endif %}

                <div class="flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="inline-flex rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">{{ 'demo.config.settings.save'|trans }}</button>
                    <a href="{{ demo_route.path('demo_cookie_consent_config_index') }}" class="inline-flex rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">{{ 'demo.config.form.cancel'|trans }}</a>
                </div>
            {{ form_end(form) }}
        </div>
    </main>
{% endblock %}
