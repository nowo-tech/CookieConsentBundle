{#-
  REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
  asset package, no CSS framework, no CDN, no token overrides). It is also the layout of the bundle admin pages
  (nowo_ui_kit.layouts.admin, REQ-UI-003). The consent widget and its diagnostics script are the bundle's own, unchanged.
-#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}
{% import 'demo/_routes.html.twig' as demo_route %}

{% block nowo_ui_document_title %}{% block title %}Cookie Consent Demo{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍪</text></svg>">
    {% block stylesheets %}{% endblock %}
    {% if app.debug %}
        {#- Dev only: keep the consent banner and the preferences bubble clear of the open WebProfiler toolbar (36px). -#}
        <style>
            body:has(.sf-toolbar-opened) .nowo-cookie-consent.show { padding-bottom: calc(1rem + 36px); }
            body:has(.sf-toolbar-opened) .nowo-cookie-consent__preferences-bubble[class*='--bottom-'] { bottom: calc(1.25rem + 36px); }
        </style>
    {% endif %}
{% endblock %}

{% block nowo_ui_navigation %}
    {% include 'demo/_nav.html.twig' %}
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_body %}
    {{ parent() }}
    {% if nowo_cookie_consent_should_embed_modal() %}
        {{ render(path('nowo_cookie_consent.show_if_not_set')) }}
    {% endif %}

    {% include '@NowoCookieConsentBundle/_diagnostics_script.html.twig' %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% block javascripts %}{% endblock %}
{% endblock %}
