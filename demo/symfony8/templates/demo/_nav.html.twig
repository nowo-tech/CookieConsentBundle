{% import 'demo/_routes.html.twig' as demo_route %}
{% set _route = app.request.attributes.get('_route') %}

<header class="nowo-ui-header" data-testid="demo-masthead">
    <a class="nowo-ui-brand" href="{{ demo_route.path('demo_home') }}">{{ 'demo.brand'|trans }}</a>
    <nav class="nowo-ui-menu" aria-label="{{ 'demo.brand'|trans }}">
        <a class="nowo-ui-link"{% if _route == 'demo_home' %} aria-current="page"{% endif %} href="{{ demo_route.path('demo_home') }}">{{ 'demo.nav.home'|trans }}</a>
        <a class="nowo-ui-link"{% if _route starts with 'demo_cookie_consent_' %} aria-current="page"{% endif %} href="{{ demo_route.path('demo_cookie_consent_config_index') }}">{{ 'demo.nav.config'|trans }}</a>
        <a class="nowo-ui-link"{% if _route == 'demo_privacy_policy' %} aria-current="page"{% endif %} href="{{ demo_route.path('demo_privacy_policy') }}">{{ 'demo.nav.privacy'|trans }}</a>
        <a class="nowo-ui-link"{% if _route == 'demo_cookie_policy' %} aria-current="page"{% endif %} href="{{ demo_route.path('demo_cookie_policy') }}">{{ 'demo.nav.cookies'|trans }}</a>
        <a class="nowo-ui-link"{% if _route == 'demo_consent_information' %} aria-current="page"{% endif %} href="{{ demo_route.path('demo_consent_information') }}">{{ 'demo.nav.consent'|trans }}</a>
    </nav>
    <div class="nowo-ui-header__end">
        {% for locale in nowo_cookie_consent_enabled_locales() %}
            <a class="nowo-ui-link"{% if app.request.locale == locale %} aria-current="true"{% endif %} href="{{ demo_route.switch_locale(locale) }}">{{ locale|upper }}</a>
        {% endfor %}
        {% include '@NowoCookieConsentBundle/cookie_consent_manage_link.html.twig' with { class: 'nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm' } %}
        {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
    </div>
</header>
