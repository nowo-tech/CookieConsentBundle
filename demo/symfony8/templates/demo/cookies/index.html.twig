{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.cookies.title'|trans({'%profile%': config.displayName}) }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('demo_cookie_consent_config_show', { configId: config.id, _locale: app.request.locale }) }}">{{ 'demo.cookies.back_to_profile'|trans }}</a>
        <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('demo_cookie_consent_cookies_new', { configId: config.id, _locale: app.request.locale }) }}">{{ 'demo.cookies.new'|trans }}</a>
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.cookies.title'|trans({'%profile%': config.displayName}), intro: 'demo.cookies.lead'|trans, toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.cookies.title'|trans({'%profile%': config.displayName}), kind: 'table', empty: definitions is empty, state_message: 'demo.cookies.empty'|trans, definitions: definitions, config: config} %}
        {% block section_body %}
            <table class="nowo-ui-table nowo-ui-table--striped">
                <thead>
                    <tr>
                        <th>{{ 'demo.cookies.table.name'|trans }}</th>
                        <th>{{ 'demo.cookies.table.provider'|trans }}</th>
                        <th class="nowo-ui-cell--wrap">{{ 'demo.cookies.table.purpose'|trans }}</th>
                        <th>{{ 'demo.cookies.table.category'|trans }}</th>
                        <th>{{ 'demo.cookies.table.duration'|trans }}</th>
                        <th>{{ 'demo.cookies.table.allowed_by_default'|trans }}</th>
                        <th>{{ 'demo.cookies.table.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for definition in definitions %}
                        {% set translation = definition.findTranslation(app.request.locale) ?? definition.findTranslation('en') %}
                        <tr>
                            <td><code class="nowo-ui-code">{{ definition.name }}</code></td>
                            <td>{{ translation ? translation.provider : '' }}</td>
                            <td class="nowo-ui-cell--wrap">{{ translation ? translation.purpose : '' }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ ('demo.cookies.category.' ~ definition.category)|trans }}</span></td>
                            <td>{{ definition.duration }}</td>
                            <td>{{ definition.allowedByDefault ? 'demo.cookies.yes'|trans : 'demo.cookies.no'|trans }}</td>
                            <td class="nowo-ui-table__actions">
                                <a class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline" href="{{ path('demo_cookie_consent_cookies_edit', { configId: config.id, id: definition.id, _locale: app.request.locale }) }}">{{ 'demo.cookies.edit'|trans }}</a>
                                <button type="button" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--danger" data-nowo-confirm-open data-nowo-confirm-target="delete-cookie-{{ definition.id }}">{{ 'demo.cookies.delete'|trans }}</button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block nowo_ui_modals %}
    {% for definition in definitions %}
        {{ include('demo/_delete_confirm.html.twig', {id: 'delete-cookie-' ~ definition.id, title: 'demo.cookies.delete'|trans, message: 'demo.cookies.delete_confirm'|trans({'%name%': definition.name}), form: delete_forms[definition.id], label: 'demo.cookies.delete'|trans}) }}
    {% endfor %}
{% endblock %}
