{% extends 'base.html.twig' %}
{% import 'demo/_routes.html.twig' as demo_route %}

{% block title %}{{ isNew ? 'demo.cookies.new_title'|trans : 'demo.cookies.edit_title'|trans({'%name%': definition.name}) }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: isNew ? 'demo.cookies.new_title'|trans : 'demo.cookies.edit_title'|trans({'%name%': definition.name}),
        intro: 'demo.cookies.form_lead'|trans({'%profile%': config.displayName}),
    }) }}
{% endblock %}

{% block body %}
    <div class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {{ form_start(form) }}
                {# Name/duration and category/type/sortOrder keep their order; the loop renders the remaining fields; translations use the locale tabs below. #}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'translations' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}

                <h2 class="nowo-ui-card__title">{{ 'demo.cookies.fields.translations'|trans }}</h2>
                <p class="nowo-ui-muted">{{ 'demo.cookies.translations_lead'|trans }}</p>
                {# Bundle 1.18: one fixed tab per enabled locale (FormKit locale_tabs, entries mode; UiKit renderer). #}
                {{ include('@NowoFormKitBundle/form/_locale_tabs.html.twig', {
                    field: form.translations,
                    mode: 'entries',
                    locales: form.vars.enabled_locales,
                    default_locale: form.vars.default_locale,
                    tabs_id: 'nowo-cc-definition-translations',
                    testid: 'nowo-cc-definition-translations',
                    legend: false,
                }, with_context: false) }}
                {{ form_errors(form.translations) }}

                <div class="nowo-ui-form__actions">
                    <button type="submit" class="nowo-ui-btn nowo-ui-btn--primary">{{ 'demo.cookies.save'|trans }}</button>
                    <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ demo_route.path('demo_cookie_consent_cookies_index', { configId: config.id }) }}">{{ 'demo.config.form.cancel'|trans }}</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/nowo-ui-tabs.js', 'nowo_ui_kit') }}" defer></script>
{% endblock %}
