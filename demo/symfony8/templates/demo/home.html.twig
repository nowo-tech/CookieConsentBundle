{% extends 'base.html.twig' %}
{% import 'demo/_routes.html.twig' as demo_route %}

{% block title %}{{ 'demo.home.title'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.home.title'|trans,
        intro: 'demo.home.lead'|trans({
            '%table%': 'demo_nowo_cookie_consent_log',
            '%prefix%': 'table_prefix',
        }),
    }) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {% include 'demo/_home_content.html.twig' %}

            {{ form_start(reset_form) }}
                {% for child in reset_form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                <button type="submit" class="nowo-ui-btn nowo-ui-btn--danger">{{ 'demo.home.reset'|trans }}</button>
                <span class="nowo-ui-muted">{{ 'demo.home.reset_help'|trans }}</span>
            {{ form_end(reset_form) }}
        </div>
    </section>
{% endblock %}
