{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.home.title'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.home.title'|trans,
        intro: 'demo.home.lead'|trans({
            '%table%': 'demo_nowo_cookie_consent_log',
            '%prefix%': 'table_prefix',
        }),
    }) }}
{% endblock %}

{% block body %}
    {% include 'demo/_home_content.html.twig' %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.home.reset'|trans, intro: 'demo.home.reset_help'|trans, kind: 'form', reset_form: reset_form} %}
        {% block section_body %}
            {{ form_start(reset_form) }}
                {% for child in reset_form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                <button type="submit" class="nowo-ui-btn nowo-ui-btn--danger">{{ 'demo.home.reset'|trans }}</button>
            {{ form_end(reset_form) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
