{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.config.new.title'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.config.new.title'|trans ~ ' — ' ~ config.displayName}) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            {% include 'demo/config/_form.html.twig' with { submit_label: 'demo.config.form.create'|trans } %}
        </div>
    </section>
{% endblock %}
