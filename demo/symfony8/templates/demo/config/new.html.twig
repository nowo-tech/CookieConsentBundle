{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.config.new.title'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.config.new.title'|trans ~ ' — ' ~ config.displayName, intro: 'demo.config.form.lead'|trans}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.config.new.title'|trans ~ ' — ' ~ config.displayName, kind: 'form', form: form} %}
        {% block section_body %}
            {% include 'demo/config/_form.html.twig' with { submit_label: 'demo.config.form.create'|trans } %}
        {% endblock %}
    {% endembed %}
{% endblock %}
