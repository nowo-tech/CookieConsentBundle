{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.config.edit.title'|trans({'%locale%': translation.locale}) }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.config.edit.title'|trans({'%locale%': translation.locale}), intro: 'demo.config.form.lead'|trans}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.config.edit.title'|trans({'%locale%': translation.locale}), kind: 'form', form: form} %}
        {% block section_body %}
            {% include 'demo/config/_form.html.twig' with { submit_label: 'demo.config.form.save'|trans } %}
        {% endblock %}
    {% endembed %}
{% endblock %}
