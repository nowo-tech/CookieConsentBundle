{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.home.consent_saved'|trans, intro: 'demo.home.playground_hint'|trans, kind: 'list'} %}
    {% block section_body %}
        <ul class="nowo-ui-list">
            <li class="nowo-ui-list-item">
                <span>{{ 'demo.home.consent_saved'|trans }}</span>
                <span class="nowo-ui-badge nowo-ui-badge--{{ nowo_cookie_consent_is_saved() ? 'success' : 'warning' }}">
                    {{ nowo_cookie_consent_is_saved() ? 'demo.home.yes'|trans : 'demo.home.no'|trans }}
                </span>
            </li>
            {% for category in ['functionality', 'preferences', 'analytics', 'marketing'] %}
                <li class="nowo-ui-list-item">
                    <span>{{ ('demo.home.' ~ category ~ '_allowed')|trans }}</span>
                    <span class="nowo-ui-badge nowo-ui-badge--{{ nowo_cookie_consent_is_category_allowed(category) ? 'success' : 'neutral' }}">
                        {{ nowo_cookie_consent_is_category_allowed(category) ? 'demo.home.yes'|trans : 'demo.home.no'|trans }}
                    </span>
                </li>
            {% endfor %}
        </ul>
    {% endblock %}
{% endembed %}

{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.home.blocking_title'|trans, intro: 'demo.home.blocking_lead'|trans, kind: 'list'} %}
    {% block section_body %}
        <ul class="nowo-ui-list">
            <li class="nowo-ui-list-item">
                <span>{{ 'demo.home.functionality_widget'|trans }}</span>
                {{ include('demo/_category_badge.html.twig', {allowed: nowo_cookie_consent_is_category_allowed('functionality')}) }}
            </li>
            <li class="nowo-ui-list-item">
                <span>{{ 'demo.home.preferences_storage'|trans }}</span>
                {{ include('demo/_category_badge.html.twig', {allowed: nowo_cookie_consent_is_category_allowed('preferences')}) }}
            </li>
            <li class="nowo-ui-list-item">
                <span>{{ 'demo.home.analytics_script'|trans }}</span>
                {{ include('demo/_category_badge.html.twig', {allowed: nowo_cookie_consent_is_category_allowed('analytics')}) }}
            </li>
            <li class="nowo-ui-list-item">
                <span>{{ 'demo.home.marketing_script'|trans }}</span>
                {{ include('demo/_category_badge.html.twig', {allowed: nowo_cookie_consent_is_category_allowed('marketing')}) }}
            </li>
        </ul>

        <script type="text/plain" data-cookie-category="functionality">
            window.__demoFunctionalityLoaded = true;
        </script>
        <script type="text/plain" data-cookie-category="preferences">
            window.__demoPreferencesLoaded = true;
        </script>
        <script type="text/plain" data-cookie-category="analytics">
            window.__demoAnalyticsLoaded = true;
        </script>

        <div data-nowo-iframe-category="marketing"
             data-nowo-iframe-src="https://example.com/embed/marketing-demo"
             data-nowo-iframe-title="Demo marketing video placeholder"
             data-nowo-iframe-allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
            <p class="nowo-ui-muted">{{ 'demo.home.blocked'|trans }} — {{ 'demo.home.marketing_script'|trans }}</p>
        </div>
    {% endblock %}
    {% block section_footer %}
        <a class="nowo-ui-link" href="{{ path('demo_cookie_policy', {_locale: app.request.locale}) }}">{{ 'demo.home.inventory_link'|trans }}</a>
    {% endblock %}
{% endembed %}
